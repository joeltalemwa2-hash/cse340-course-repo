<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">Organization</p>
    <h1><%= organization.name %></h1>
  </div>
</section>

<section class="detail-section">
  <div class="wrap">
    <img class="detail-image" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
    <p><%= organization.description %></p>
    <p class="detail-meta"><%= organization.contact_email %></p>

    <h2>Projects from this organization</h2>
    <% if (projects.length === 0) { %>
      <p>No projects listed yet.</p>
    <% } else { %>
      <ul class="detail-links">
        <% projects.forEach((project) => { %>
          <li><a href="/projects/<%= project.project_id %>"><%= project.title %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <a class="btn btn--ghost" href="/organizations">&larr; Back to organizations</a>
  </div>
</section>

<%- include('partials/footer') %>