<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">Service Project</p>
    <h1><%= project.title %></h1>
  </div>
</section>

<section class="detail-section">
  <div class="wrap">
    <p><%= project.description %></p>
    <p class="detail-meta">
      <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
      &middot; <%= project.location %>
    </p>
    <p class="detail-meta">
      Sponsored by <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <h2>Categories</h2>
    <% if (categories.length === 0) { %>
      <p>No categories assigned yet.</p>
    <% } else { %>
      <ul class="tag-row">
        <% categories.forEach((category) => { %>
          <li><a class="tag tag--moss" href="/categories/<%= category.category_id %>"><%= category.name %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <a class="btn btn--ghost" href="/projects">&larr; Back to service projects</a>
  </div>
</section>

<%- include('partials/footer') %>