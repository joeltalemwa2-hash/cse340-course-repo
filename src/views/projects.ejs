<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">On the calendar</p>
    <h1><%= title %></h1>
    <p class="page-header__lede">Specific, recurring projects you can plan around — not just open-ended volunteering.</p>
  </div>
</section>

<section class="project-list-section">
  <div class="wrap">
    <ul class="project-list">
      <% projects.forEach((project) => { %>
        <% const friendlyDate = new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
        <li class="project-row">
          <h2><%= friendlyDate %>: <a href="/projects/<%= project.project_id %>"><%= project.title %></a> (<%= project.organization_name %>)</h2>
          <p><%= project.description %></p>
          <p class="project-row__meta"><%= project.location %></p>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<%- include('partials/footer') %>