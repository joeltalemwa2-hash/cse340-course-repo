<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">Service Projects</p>
    <h1><%= title %></h1>
  </div>
</section>

<section class="form-section">
  <div class="wrap">
    <form class="site-form" action="/edit-project/<%= projectDetails.project_id %>" method="POST">
      <div class="form-group">
        <label for="title">Project Title</label>
        <input type="text" id="title" name="title" maxlength="200" required value="<%= projectDetails.title %>">
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" maxlength="1000" required><%= projectDetails.description %></textarea>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" maxlength="200" required value="<%= projectDetails.location %>">
      </div>

      <div class="form-group">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" required value="<%= new Date(projectDetails.date).toISOString().split('T')[0] %>">
      </div>

      <div class="form-group">
        <label for="organizationId">Organization</label>
        <select id="organizationId" name="organizationId" required>
          <% organizations.forEach((organization) => { %>
            <option value="<%= organization.organization_id %>" <%= organization.organization_id === projectDetails.organization_id ? 'selected' : '' %>><%= organization.name %></option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="btn btn--primary">Update Project</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>