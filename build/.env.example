# Copy this file to .env and adjust values as needed.
# .env itself is listed in .gitignore and should never be pushed to GitHub.
DB_URL=postgresql://username:password@host:5432/databasename
ENABLE_SQL_LOGGING=true
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate_your_own_with_the_node_crypto_command_in_the_instructions
